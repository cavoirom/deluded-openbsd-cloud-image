#! /bin/ksh
set -o errexit

export PATH="/usr/local/bin:${PATH}"
export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# Setting /etc/installurl
echo "https://cdn.openbsd.org/pub/OpenBSD" > /etc/installurl

# Fix the time to prevent TLS errors
rdate pool.ntp.org

#######################
# Cloud-init installation
#######################
CLOUD_INIT_VERSION=26.2

pkgs="
   python%3
   py3-passlib
"
for pkg in ${pkgs}; do
   echo "Installing ${pkg}"
   pkg_add "${pkg}"
done

cd /tmp

echo "Downloading cloud-init ${CLOUD_INIT_VERSION}"
ftp "https://github.com/canonical/cloud-init/archive/refs/tags/${CLOUD_INIT_VERSION}.tar.gz"
tar xzf ${CLOUD_INIT_VERSION}.tar.gz

cd "cloud-init-${CLOUD_INIT_VERSION}"

###########
# Patching cloud-init bugs
###########

# Fix: update_etc_hosts requires hosts.openbsd.tmpl which is absent on OpenBSD
# causing a permanent status:failed at every boot
sed -i 's/^  - update_etc_hosts/  # - update_etc_hosts/' config/cloud.cfg.tmpl

###########
# Build cloud-init
###########

# Install runtime dependencies without sudo or the CI/test dependency set.
runtime_pkgs=$(./tools/read-dependencies --distro openbsd --runtime-requires |
    grep -v '^sudo--$')
pkg_add ${runtime_pkgs}
pkg_add bash meson
meson setup builddir -Dinit_system=sysvinit_openbsd -Dsysconfdir=/etc \
    -Dbash_completion=false
meson install -C builddir
pkg_delete meson bash
pkg_delete -a

# These services run complete provisioning stages, not short daemon startups.
for service in cloudinitlocal cloudinit cloudconfig cloudfinal; do
    rcctl set "$service" timeout 300
done

###########
# Key-only login and first-password setup
###########

# A dead password rejects BSD authentication even while its field is empty.
# passwd can then set the first password without requesting an old password.
cat >> /etc/login.conf <<'EOF'

cavoirom:\
    :auth=passwd:\
    :auth-doas=passwd:\
    :password-dead=0:\
    :passwordtime=0:\
    :tc=default:
EOF
cap_mkdb /etc/login.conf
useradd -m -s /bin/ksh -G wheel -L cavoirom -p '' -f 1 cavoirom

# Put policy before existing directives: sshd uses the first obtained value.
# Keep access key-only even before cloud-init applies ssh_pwauth.
cat > /tmp/sshd-policy <<'EOF'
AllowUsers cavoirom
AuthenticationMethods publickey
PubkeyAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
EOF
cat /tmp/sshd-policy /etc/ssh/sshd_config > /tmp/sshd_config
install -m 600 /tmp/sshd_config /etc/ssh/sshd_config
rm /tmp/sshd-policy /tmp/sshd_config

# Do not let cloud-init lock or replace the pre-created user's password.
# Its SSH module installs our key and keys supplied by the cloud platform.
cat > /etc/cloud/cloud.cfg.d/99-cavoirom.cfg <<'EOF'
users:
  - default
disable_root: true
ssh_pwauth: false
ssh_authorized_keys:
  - 'sk-ecdsa-sha2-nistp256@openssh.com AAAAInNrLWVjZHNhLXNoYTItbmlzdHAyNTZAb3BlbnNzaC5jb20AAAAIbmlzdHAyNTYAAABBBLNO6avyfBTjQtE3OifB61ecly2LlyFm54MWLfSjOG3nmxooHsGohIT98F9weXE3q749fK1pnywchqxm9GxybFsAAAAEc3NoOg== ssh:'
# OpenBSD generates missing keys before starting sshd. Keep those keys stable.
ssh_deletekeys: false
system_info:
  default_user:
    name: cavoirom
    gecos: cavoirom
    groups: [wheel]
    shell: /bin/ksh
    lock_passwd: false
    # Acknowledge the initial blank field without overwriting a later password.
    hashed_passwd: ''
    sudo: null
    doas:
      - permit persist cavoirom as root
EOF

/usr/sbin/sshd -G > /dev/null
if pkg_info -e 'sudo-*'; then
    echo 'Unexpected sudo package in the image' >&2
    exit 1
fi
usermod -p '*' root
rm -f /root/.ssh/authorized_keys

###########
# Clean-up
###########

cd /tmp
rm -r "/tmp/cloud-init-${CLOUD_INIT_VERSION}" "/tmp/${CLOUD_INIT_VERSION}.tar.gz"

# Each instance must generate its own host keys.
rm -f /etc/ssh/ssh_host_*

# Clean-up the network config
rm -f /etc/resolv.conf /etc/hostname.*

echo "\nThis cloud-image has been generated by build_openbsd_qcow2.sh\n" >> /etc/motd
echo "cf. https://github.com/hcartiaux/openbsd-cloud-image/"             >> /etc/motd
echo "This image comes with a minimalist / partition. You can use the"   >> /etc/motd
echo "remaining disk space by adjusting /root/bin/create_partitions.sh"  >> /etc/motd
echo "to match your expectations and run the script as root."            >> /etc/motd

rm /install.site

# Zero out free space (reduce the image size)
dd if=/dev/zero of=/zero.dat bs=1M || true
rm -f /zero.dat
